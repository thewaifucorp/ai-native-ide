{
  "private": true,
  "name": "ide-theia-spike",
  "version": "0.0.1",
  "description": "Minimal Eclipse Theia browser app spike (Phase 1 R&D)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "engine-extension": "link:engine-extension",
    "instrument-theme-extension": "link:instrument-theme-extension",
    "instrument-shell-extension": "link:instrument-shell-extension",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@theia/core": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/workspace": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/plugin-ext": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/vsx-registry": "1.74.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "theia build --mode development",
    "clean": "theia clean",
    "patch:drivelist": "node scripts/patch-drivelist.js",
    "build:ext": "tsc -p engine-extension && tsc -p instrument-theme-extension && tsc -p instrument-shell-extension",
    "build": "yarn build:ext && theia build --mode development",
    "download:plugins": "theia download:plugins",
    "start": "VSX_REGISTRY_URL=https://open-vsx.org theia start ./workspace --plugins=local-dir:plugins --hostname 0.0.0.0 --port 3010",
    "test:ext": "tsc -p instrument-shell-extension && mocha \"instrument-shell-extension/lib/node/*.spec.js\"",
    "test:journey": "tsc -p instrument-shell-extension && mocha --exit --timeout 120000 \"instrument-shell-extension/lib/node/*.e2e.js\""
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Instrument \u00b7 IDE (001 spike)",
        "defaultTheme": "instrument-dark",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "workbench.colorTheme": "instrument-dark",
          "window.menuBarVisibility": "hidden",
          "editor.fontFamily": "'DM Mono', ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace",
          "editor.fontSize": 13,
          "editor.lineHeight": 20,
          "terminal.integrated.fontFamily": "'DM Mono', ui-monospace, monospace"
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "ms-vscode.js-debug": "https://open-vsx.org/api/ms-vscode/js-debug/1.117.0/file/ms-vscode.js-debug-1.117.0.vsix",
    "mtxr.sqltools": "https://open-vsx.org/api/mtxr/sqltools/0.28.6/file/mtxr.sqltools-0.28.6.vsix",
    "vscode.css": "https://open-vsx.org/api/vscode/css/1.95.3/file/vscode.css-1.95.3.vsix",
    "vscode.css-language-features": "https://open-vsx.org/api/vscode/css-language-features/1.95.3/file/vscode.css-language-features-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.79.0/file/vscode.git-1.79.0.vsix",
    "vscode.html": "https://open-vsx.org/api/vscode/html/1.95.3/file/vscode.html-1.95.3.vsix",
    "vscode.html-language-features": "https://open-vsx.org/api/vscode/html-language-features/1.95.3/file/vscode.html-language-features-1.95.3.vsix",
    "vscode.javascript": "https://open-vsx.org/api/vscode/javascript/1.95.3/file/vscode.javascript-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "vscode.markdown": "https://open-vsx.org/api/vscode/markdown/1.95.3/file/vscode.markdown-1.95.3.vsix",
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.95.3/file/vscode.markdown-language-features-1.95.3.vsix",
    "vscode.npm": "https://open-vsx.org/api/vscode/npm/1.95.3/file/vscode.npm-1.95.3.vsix",
    "vscode.shellscript": "https://open-vsx.org/api/vscode/shellscript/1.95.3/file/vscode.shellscript-1.95.3.vsix",
    "vscode.typescript-language-features": "https://open-vsx.org/api/vscode/typescript-language-features/1.95.3/file/vscode.typescript-language-features-1.95.3.vsix",
    "vscode.yaml": "https://open-vsx.org/api/vscode/yaml/1.95.3/file/vscode.yaml-1.95.3.vsix"
  }
}
